+// Caps queued streams, socket creation and retained protocol state independently from packet byte windows.
+const MAX_TCP_SOCKETS: usize = 1024;
+// Identifies both endpoints of a TCP connection, including their address families.
+type FlowKey = (SocketAddr, SocketAddr);
+// Tracks a tuple until its protocol socket is actually retired, including TIME-WAIT.
+struct FlowLease { key: FlowKey, active: Arc<SpinMutex<HashSet<FlowKey>>> }
+// Reserves one tuple exactly once while enforcing the protocol socket limit.
+impl FlowLease {
+    fn acquire(key: FlowKey, active: &Arc<SpinMutex<HashSet<FlowKey>>>) -> Option<Self> {
+        let mut flows = active.lock();
+        if flows.len() >= MAX_TCP_SOCKETS || !flows.insert(key) { return None; }
+        Some(Self { key, active: Arc::clone(active) })
+    }
+}
+// Releases tuple ownership when the runner removes its protocol socket or the runner is dropped.
+impl Drop for FlowLease { fn drop(&mut self) { self.active.lock().remove(&self.key); } }
 
