+    /// Owns bounded TCP relays so shutdown cancels them and completed tasks are reaped promptly.
+    async fn run_tcp(mut listener: netstack_smoltcp::TcpListener, client: Arc<ClientHandle>, errors: Arc<ErrorLog>) -> Result<()> {
+        let permits = Arc::new(tokio::sync::Semaphore::new(256));
+        let mut relays = tokio::task::JoinSet::new();
+        loop {
+            tokio::select! {
+                biased;
+                result = relays.join_next(), if !relays.is_empty() => {
+                    if let Some(Err(error)) = result { errors.report(format_args!("TUN TCP relay task failed: {error}")); }
+                }
+                accepted = listener.next() => {
+                    let Some((stream, source, destination)) = accepted else { return Err(CliError::new("TUN TCP listener stopped")); };
+                    let Ok(permit) = Arc::clone(&permits).try_acquire_owned() else {
+                        errors.report(format_args!("HY2UI_TCP_ERROR capacity"));
+                        drop(stream); continue;
+                    };
+                    let (client, errors) = (Arc::clone(&client), Arc::clone(&errors));
+                    relays.spawn(async move { let _permit = permit; forward_tcp(stream, source, destination, client, errors).await; });
+                }
+            }
+        }
+    }
+
